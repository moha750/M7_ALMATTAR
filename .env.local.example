# ===========================================================================
# متغيّرات البيئة — انسخ هذا الملف إلى .env.local واملأ القيم
# تجدها في: Supabase Dashboard → Project Settings → API
# ===========================================================================

# عنوان مشروع Supabase (عام)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# مفتاح anon العام (آمن للمتصفّح — تحميه سياسات RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# مفتاح service_role (سرّي — للخادم فقط، لا يبدأ بـ NEXT_PUBLIC إطلاقًا)
# يُستخدم في عمليات الأدمن مثل حذف ملفات التخزين عند حذف مشروع.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# عنوان الموقع للروابط المطلقة و OG (اختياري في التطوير)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
