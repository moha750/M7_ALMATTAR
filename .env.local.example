# ===========================================================================
# انسخ هذا الملف إلى .env.local واملأ القيم. (.env.local غير مُتتبَّع في git)
# ===========================================================================

# --- Supabase API (من: Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# --- اتصال قاعدة البيانات المباشر (من زر Connect → Session pooler → URI) ---
# يحتوي كلمة مرور قاعدة البيانات؛ سرّي. مثال:
# postgresql://postgres.abcdef:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# --- حساب أول دخول للوحة التحكم (مؤقت — احذفه بعد إنشاء الحساب) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# عنوان الموقع للروابط المطلقة و OG
NEXT_PUBLIC_SITE_URL=http://localhost:3000
